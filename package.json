{
  "name": "kxco-pq-chain",
  "version": "2.1.0",
  "description": "HTTP client for the KXCO post-quantum identity relay. Sign ML-DSA-65 intents and POST them to relay.kxco.ai: KXCO validates the signature, pays gas and submits the EVM transaction on Armature L1 (chain 1111111). No wallets, no gas, no node. Writes to a hosted relay require a licence key.",
  "keywords": [
    "post-quantum",
    "pqc",
    "ml-dsa",
    "nist",
    "fips-204",
    "blockchain",
    "meta-transaction",
    "relay",
    "kxco",
    "armature",
    "identity-registry",
    "credential",
    "audit-anchor",
    "attestation"
  ],
  "license": "Apache-2.0",
  "author": "Shayne Heffernan and John Heffernan",
  "contributors": [
    {
      "name": "Shayne Heffernan"
    },
    {
      "name": "John Heffernan"
    }
  ],
  "homepage": "https://kxco.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KnightsbridgeAIQ/kxco-pq-chain.git"
  },
  "bugs": {
    "url": "https://github.com/KnightsbridgeAIQ/kxco-pq-chain/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "RELAY.md",
    "src"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "kxco-post-quantum": "^1.3.0"
  },
  "scripts": {
    "test": "node --test --test-timeout=30000 test/chain.test.js test/licence.test.js test/verified-path.test.js"
  },
  "funding": "https://kxco.ai",
  "publishConfig": {
    "access": "public"
  }
}
