{
  "name": "kxco-pq-chain",
  "version": "2.1.1",
  "description": "Sign an ML-DSA-65 intent, POST it to the KXCO relay, and Armature L1 verifies the signature in consensus: every validator checks it as a protocol rule, so a counterparty confirms the write from chain data. KXCO pays the gas and submits. No wallets, no gas, no node.",
  "keywords": [
    "post-quantum",
    "pqc",
    "ml-dsa",
    "nist",
    "fips-204",
    "blockchain",
    "meta-transaction",
    "relay",
    "kxco",
    "armature",
    "identity-registry",
    "credential",
    "audit-anchor",
    "attestation"
  ],
  "license": "Apache-2.0",
  "author": "Shayne Heffernan and John Heffernan",
  "contributors": [
    {
      "name": "Shayne Heffernan"
    },
    {
      "name": "John Heffernan"
    }
  ],
  "homepage": "https://kxco.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KnightsbridgeAIQ/kxco-pq-chain.git"
  },
  "bugs": {
    "url": "https://github.com/KnightsbridgeAIQ/kxco-pq-chain/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "RELAY.md",
    "VERIFIED-PATH.md",
    "src"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "kxco-post-quantum": "^1.3.0"
  },
  "scripts": {
    "test": "node --test --test-timeout=30000 test/chain.test.js test/licence.test.js test/verified-path.test.js"
  },
  "funding": "https://kxco.ai",
  "publishConfig": {
    "access": "public"
  }
}
