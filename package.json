{
  "name": "kxco-pq-chain",
  "version": "2.3.1",
  "description": "Post-quantum writes to Armature L1: every validator verifies your ML-DSA-65 signature in consensus, and KXCO pays the gas. No wallet, token or node. Register identities, issue and revoke credentials, rotate keys, and anchor audit roots and attestations.",
  "keywords": [
    "post-quantum",
    "pqc",
    "ml-dsa",
    "nist",
    "fips-204",
    "blockchain",
    "meta-transaction",
    "relay",
    "kxco",
    "armature",
    "identity-registry",
    "credential",
    "audit-anchor",
    "attestation",
    "pqc-migration",
    "crypto-agility",
    "digital-signature",
    "non-repudiation",
    "tamper-evident",
    "gasless",
    "on-chain-verification",
    "evm",
    "key-rotation"
  ],
  "license": "Apache-2.0",
  "author": "Shayne Heffernan and John Heffernan",
  "contributors": [
    {
      "name": "Shayne Heffernan"
    },
    {
      "name": "John Heffernan"
    }
  ],
  "homepage": "https://kxco.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KnightsbridgeAIQ/kxco-pq-chain.git"
  },
  "bugs": {
    "url": "https://github.com/KnightsbridgeAIQ/kxco-pq-chain/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "RELAY.md",
    "VERIFIED-PATH.md",
    "src",
    "ASSESSMENT.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "kxco-post-quantum": "^1.6.0"
  },
  "scripts": {
    "test": "node --test --test-timeout=30000 test/chain.test.js test/licence.test.js test/verified-path.test.js test/property.test.js test/ml-dsa-87.test.js test/ml-dsa-87-verified.test.js test/verifier-rediscovery.test.js",
    "evidence": "node scripts/build-evidence.mjs"
  },
  "funding": "https://kxco.ai",
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "devDependencies": {
    "fast-check": "4.10.2"
  }
}
